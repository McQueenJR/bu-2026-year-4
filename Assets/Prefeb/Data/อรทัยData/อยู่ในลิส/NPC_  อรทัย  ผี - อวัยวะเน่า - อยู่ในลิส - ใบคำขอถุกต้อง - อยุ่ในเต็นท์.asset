  age: 35
  voiceType: 0
  dialogs:
  - "\u0E02\u0E2D\u0E42\u0E17\u0E29\u0E17\u0E35\u0E48\u0E01\u0E25\u0E31\u0E1A\u0E14\u0E36\u0E01\u0E19\u0E30\u0E04\u0E30
